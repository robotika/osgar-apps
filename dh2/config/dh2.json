{
  "version": 2,
  "robot": {
    "modules": {
      "app": {
        "driver": "dh2.main:ConeExplore",
        "init": {
          "terminate_on_stop": true,
          "max_speed": 0.3,
          "min_speed": 0.15,
          "explore_speed": 0.2,
          "stop_height": 0.65,
          "step_distance": 0.5,
          "scan_dwell": 1.5,
          "scan_settle": 0.5,
          "obstacle_stop_dist": 0.7,
          "obstacle_resume_dist": 1.0,
          "obstacle_min_pixels": 20,
          "required_cones": 4,
          "visit_wait": 3.0,
          "repeat_radius": 1.0,
          "allow_reverse": true,
          "reverse_distance": 0.3,
          "reverse_speed": 0.1
        }
      },
      "platform": {
        "driver": "osgar.platforms.matty:Matty",
        "in": [
          "esp_data"
        ],
        "out": [
          "esp_data"
        ],
        "init": {}
      },
      "timer": {
        "driver": "timer",
        "in": [],
        "out": [
          "tick"
        ],
        "init": {
          "sleep": 0.1
        }
      },
      "gps": {
        "driver": "gps",
        "in": [
          "raw"
        ],
        "out": [
          "nmea_data"
        ],
        "init": {}
      },
      "serial": {
        "driver": "serial",
        "in": [
          "raw"
        ],
        "out": [
          "raw"
        ],
        "init": {
          "port": "/dev/esp32",
          "speed": 115200
        }
      },
      "oak": {
        "driver": "osgar.drivers.oak_camera:OakCamera",
        "init": {
          "fps": 10,
          "is_color": true,
          "video_encoder": "h265",
          "h264_bitrate": 2000,
          "is_depth": true,
          "is_stereo_images": false,
          "laser_projector_current": 0,
          "flood_light_current": 0,
          "is_imu_enabled": false,
          "number_imu_records": 10,
          "disable_magnetometer_fusion": true,
          "mono_resolution": [
            640,
            400
          ],
          "color_resolution": "THE_1080_P",
          "color_manual_focus": 130,
          "stereo_median_filter": "KERNEL_3x3",
          "stereo_mode": "HIGH_ACCURACY",
          "stereo_extended_disparity": false,
          "stereo_subpixel": false,
          "stereo_left_right_check": true,
          "sleep_on_start_sec": 3,
          "models": [
            {
              "model": {
                "blob": "../cones-challenge/coneslayer.rvc2.tar.xz",
                "num_shaves": 6
              },
              "nn_config": {
                "NN_family": "YOLO",
                "input_size": "416x416"
              },
              "mappings": {
                "labels": [
                  "cone"
                ]
              }
            }
          ],
          "color_depth_alignment": false
        }
      }
    },
    "links": [
      [
        "serial.raw",
        "platform.esp_data"
      ],
      [
        "platform.esp_data",
        "serial.raw"
      ],
      [
        "platform.gps_serial",
        "gps.raw"
      ],
      [
        "timer.tick",
        "platform.tick"
      ],
      [
        "platform.emergency_stop",
        "app.emergency_stop"
      ],
      [
        "oak.detections",
        "app.detections"
      ],
      [
        "app.desired_steering",
        "platform.desired_steering"
      ],
      [
        "timer.tick",
        "app.tick"
      ],
      [
        "platform.pose2d",
        "app.pose2d"
      ],
      [
        "platform.bumpers_front",
        "app.bumpers_front"
      ],
      [
        "platform.bumpers_rear",
        "app.bumpers_rear"
      ],
      [
        "oak.depth",
        "app.depth"
      ]
    ],
    "env": {
      "OSGAR_LOGS_PREFIX": null
    }
  }
}
